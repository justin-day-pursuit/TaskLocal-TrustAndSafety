NEXT_PUBLIC_SUPABASE_URL=https://lxrdztvxvjjdauyzezsb.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# Server-only. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_ or VITE_.
# Get this from the database owner (Supabase → Project Settings → API → service_role).
# Also set this on the Vercel project (Environment Variables). Do not commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Server-only. Required to call /api/flagged-reviews and /api/reviews/:id/resolve.
# Routes fail closed (503) if this is unset. Never prefix with NEXT_PUBLIC_ or VITE_.
# The dashboard UI does not use these routes; they are an optional HTTP surface.
DASHBOARD_API_SECRET=your_dashboard_api_secret_here

# Server-only. Google AI Studio key for Gemini analysis on /analysis.
# Never prefix with NEXT_PUBLIC_ or VITE_. Get a key at https://aistudio.google.com/apikey
# The SDK also accepts GOOGLE_API_KEY; GEMINI_API_KEY is preferred when both are set.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional. If unset, the app tries gemini-3.1-pro-preview, then free fallbacks
# gemini-3.5-flash and gemini-2.5-flash. Set this to lock a single model (no auto-fallback).
# GEMINI_MODEL=gemini-3.1-pro-preview

# Optional. Non-secret IANA timezone for dashboard calendar-day counts and the
# analysis freshness cutoff (9:00 AM local). Default is UTC if unset or invalid.
# APP_TIME_ZONE=America/New_York
